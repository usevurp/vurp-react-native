# The website's project ID, from Vurp → Websites → Install. Add com.usevurp.example under its Apps tab.
EXPO_PUBLIC_VURP_PROJECT_ID=proj_
# Leave unset for production. For a local vurp-server, use your computer's LAN address (not localhost)
# so the phone or emulator can reach it, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_VURP_API_URL=
